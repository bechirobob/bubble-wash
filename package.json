{
  "name": "bubblewash-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build.mjs && vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern worker-configuration.d.ts",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/activity-projection.test.mjs tests/dispatch-location.test.mjs tests/security-hardening.test.mjs tests/totp.test.mjs tests/ui-feedback.test.mjs tests/workflow.test.mjs",
    "test:worker": "vitest run",
    "test:data": "npm run test:worker",
    "typecheck": "tsc --noEmit",
    "audit:full": "npm audit --audit-level=moderate",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm test && npm run typecheck && npm run verify:migrations && npm run audit:full && npm run audit:prod && npm run build && npm run deploy:dry-run && npm run verify:routes",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "deploy:dry-run": "npm run deploy:prepare && wrangler deploy --config dist/server/wrangler.json --dry-run --outdir dist/worker-dry-run",
    "deploy:built": "npm run deploy:prepare && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run build && npm run db:migrate:remote && npm run deploy:built",
    "verify:routes": "node scripts/verify-required-routes.mjs",
    "verify:migrations": "node scripts/verify-d1-migrations.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "mfa:setup": "node scripts/generate-totp-secret.mjs",
    "db:export": "wrangler d1 export DB --remote --output=bubble-wash-d1-export.sql"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
