{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bubble-wash",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bubblewash.co",
      "custom_domain": true
    },
    {
      "pattern": "www.bubblewash.co",
      "custom_domain": true
    }
  ],
  "vars": {
    "BUBBLEWASH_DATABASE_DRIVER": "d1",
    "BUBBLEWASH_PUBLIC_URL": "https://bubblewash.co",
    "BUBBLEWASH_DISABLE_DEMO_LOGIN": "true",
    "BUBBLEWASH_TRUST_EDGE_HEADERS": "true",
    "BUBBLEWASH_MIGRATION_ENABLED": "false",
    "BUBBLEWASH_RELEASE_SHA": "local",
    "BUBBLEWASH_DEPLOYMENT_PHASE": "local",
    "NEXT_PUBLIC_BUBBLEWASH_ONLINE_PAYMENTS_ENABLED": "false",
    "NEXT_PUBLIC_BUBBLEWASH_AUTOMATED_UPDATES_ENABLED": "false",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bubble-wash-db",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "83201",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "83202",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "83203",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PUBLIC_READ_RATE_LIMITER",
      "namespace_id": "83204",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "DISPATCH_RATE_LIMITER",
      "namespace_id": "83205",
      "simple": { "limit": 90, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *", "15 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
