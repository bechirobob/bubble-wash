[Unit]
Description=Bubble Wash notification retry and retention maintenance
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/bubblewash-pilot
Environment=BUBBLEWASH_MAINTENANCE_ORIGIN=http://127.0.0.1:3000
TimeoutStartSec=600
EnvironmentFile=/home/ubuntu/.config/bubblewash/env
ExecStart=/usr/bin/npm run maintenance:run
User=ubuntu
Group=ubuntu
