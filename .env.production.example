# Bubble Wash Cloudflare Worker configuration
# Public values belong in wrangler.jsonc. Install secret values with
# `wrangler secret put NAME`; never commit live values.

# Persistent Worker secrets (32+ characters). The deployment workflow creates
# these once and preserves them across releases.
BUBBLEWASH_SESSION_SECRET=replace-with-32-plus-random-bytes
BUBBLEWASH_MAINTENANCE_TOKEN=replace-with-32-plus-random-bytes

# Cloudflare/D1 runtime values.
BUBBLEWASH_DATABASE_DRIVER=d1
BUBBLEWASH_PUBLIC_URL=https://bubblewash.co
BUBBLEWASH_DISABLE_DEMO_LOGIN=true
BUBBLEWASH_TRUST_EDGE_HEADERS=true
BUBBLEWASH_MIGRATION_ENABLED=false

# Staff email, scrypt hashes, entity bindings, and admin TOTP live in the
# staff_credentials D1 table. The one-time migration copies the current
# production identities without putting them in Worker environment variables.
# Create future password hashes locally with:
# npm run hash-password -- "your-strong-password"
# Create a future admin TOTP secret locally with:
# npm run mfa:setup -- admin@example.com

# Set only once household collection launches; retention is then measured from
# this date.
BUBBLEWASH_HOUSEHOLD_LAUNCH_DATE=

# Exact legal identity and Ghana data-controller registration. Leave blank
# until confirmed; the site does not invent registration claims.
BUBBLEWASH_LEGAL_ENTITY_NAME=
BUBBLEWASH_DPC_REGISTRATION_NUMBER=

# Pilot feature gates. Keep false until the matching providers are approved.
NEXT_PUBLIC_BUBBLEWASH_ONLINE_PAYMENTS_ENABLED=false
NEXT_PUBLIC_BUBBLEWASH_AUTOMATED_UPDATES_ENABLED=false

# Optional public contacts. When blank, the corresponding links stay hidden.
NEXT_PUBLIC_BUBBLEWASH_WHATSAPP=
NEXT_PUBLIC_BUBBLEWASH_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required only when online payments are enabled.
PAYSTACK_SECRET_KEY=sk_live_or_test_key_here

# Transactional delivery providers. Install these as Worker secrets before
# enabling automated updates.
RESEND_API_KEY=re_xxxxxxxxx
BUBBLEWASH_EMAIL_FROM=Bubble Wash <updates@bubblewash.co>
BUBBLEWASH_OPERATIONS_EMAIL=ops@bubblewash.co
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-cloud-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-business-phone-number-id
WHATSAPP_EARLY_ACCESS_TEMPLATE=bubblewash_early_access_confirmation
WHATSAPP_PRIVACY_TEMPLATE=bubblewash_privacy_request_confirmation
WHATSAPP_BOOKING_TEMPLATE=bubblewash_booking_update
WHATSAPP_OPERATIONS_TEMPLATE=bubblewash_operations_alert
BUBBLEWASH_OPERATIONS_WHATSAPP=233XXXXXXXXX
