# Bubble Wash production environment template
# Copy to your deployment provider's secret/env UI. Do not commit real values.

BUBBLEWASH_SESSION_SECRET=replace-with-32-plus-random-bytes
BUBBLEWASH_DATABASE_PATH=/var/lib/bubblewash/bubblewash.sqlite
BUBBLEWASH_DATABASE_DRIVER=sqlite

# Maintenance authentication, MFA encryption, and encrypted backup destinations. The off-site
# path must be a separately mounted remote/object-storage filesystem.
BUBBLEWASH_MAINTENANCE_TOKEN=replace-with-32-plus-random-bytes
BUBBLEWASH_MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BUBBLEWASH_BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BUBBLEWASH_BACKUP_PRIMARY_DIR=/var/lib/bubblewash/backups
BUBBLEWASH_BACKUP_OFFSITE_DIR=/mnt/bubblewash-offsite
BUBBLEWASH_BACKUP_STATUS_PATH=/var/lib/bubblewash/backup-status.json
BUBBLEWASH_BACKUP_PRIMARY_RETENTION_DAYS=7
BUBBLEWASH_BACKUP_STAGING_RETENTION_DAYS=2
# Set only once household collection launches; active launch signups are then
# removed 12 months after this date.
BUBBLEWASH_HOUSEHOLD_LAUNCH_DATE=

# Exact legal identity and Ghana data-controller registration. Do not deploy
# policy pages with placeholders.
BUBBLEWASH_LEGAL_ENTITY_NAME=
BUBBLEWASH_DPC_REGISTRATION_NUMBER=

BUBBLEWASH_ADMIN_EMAIL=admin@example.com
BUBBLEWASH_ADMIN_PASSWORD_HASH=scrypt$generated$scrypt-hash
# Keep both flags aligned. Password-only access is the current operating mode;
# set both true only when the owner deliberately enables authenticator MFA.
BUBBLEWASH_ADMIN_MFA_REQUIRED=false
NEXT_PUBLIC_BUBBLEWASH_ADMIN_MFA_REQUIRED=false
# Optional legacy TOTP seed. New deployments should leave this blank and use
# /admin/mfa/enroll, which stores the seed encrypted with BUBBLEWASH_MFA_ENCRYPTION_KEY.
BUBBLEWASH_ADMIN_TOTP_SECRET=

BUBBLEWASH_VENDOR_EMAIL=vendor@example.com
BUBBLEWASH_VENDOR_PASSWORD_HASH=scrypt$generated$scrypt-hash
# Exact vendor_id from the approved vendor_availability roster row. The vendor
# login can only view and update orders/capacity belonging to this entity.
BUBBLEWASH_VENDOR_ENTITY_ID=vendor-approved-partner

BUBBLEWASH_SUPPORT_EMAIL=support@example.com
BUBBLEWASH_SUPPORT_PASSWORD_HASH=scrypt$generated$scrypt-hash

BUBBLEWASH_DRIVER_EMAIL=driver@example.com
BUBBLEWASH_DRIVER_PASSWORD_HASH=scrypt$generated$scrypt-hash
# Exact driver_id from the approved driver_availability roster row. The rider
# login can only view and update routes belonging to this entity.
BUBBLEWASH_DRIVER_ENTITY_ID=driver-approved-rider

# Production must disable the local demo fallback. Readiness also rejects any
# configured role hash that matches Admin123!, Vendor123!, Driver123!, or
# Support123! even when this flag is true.
BUBBLEWASH_DISABLE_DEMO_LOGIN=true

# Enable exactly the mode that matches the deployment edge so per-client rate
# limits use an IP header that the public cannot inject directly.
BUBBLEWASH_TRUST_EDGE_HEADERS=false
BUBBLEWASH_TRUST_PROXY_HEADERS=false

# Generate hashes with:
# npm run hash-password -- "your-strong-password"

# Public base URL used in payment callbacks and notification links.
BUBBLEWASH_PUBLIC_URL=https://bubblewash.co
# Optional ownership token from Google Search Console. Leave blank until the
# exact bubblewash.co property supplies one.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Pilot feature gates. Keep both false for the manual operational pilot.
# The frontend may show these services as "Coming soon", but they cannot be
# selected and the provider routes remain closed until the matching flag is true.
NEXT_PUBLIC_BUBBLEWASH_ONLINE_PAYMENTS_ENABLED=false
NEXT_PUBLIC_BUBBLEWASH_AUTOMATED_UPDATES_ENABLED=false

# Customer-facing contacts embedded into the production frontend at build time.
# These links are optional for pilot operations; when blank, they remain hidden.
# When supplied later, use digits only for WhatsApp, including country code.
NEXT_PUBLIC_BUBBLEWASH_WHATSAPP=
NEXT_PUBLIC_BUBBLEWASH_CONTACT_EMAIL=

# Future Paystack Ghana-ready card + mobile money checkout.
# Required only when NEXT_PUBLIC_BUBBLEWASH_ONLINE_PAYMENTS_ENABLED=true.
# Docs checked: https://docs-v2.paystack.com/docs/api/transaction/
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key

# Resend transactional email. Early-access and privacy confirmations use this
# even while commercial order automation remains disabled.
# Docs checked: https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=re_xxxxxxxxx
BUBBLEWASH_EMAIL_FROM=Bubble Wash <updates@bubblewash.co>
BUBBLEWASH_OPERATIONS_EMAIL=ops@bubblewash.co

# WhatsApp Cloud API approved templates. Early-access and privacy templates are
# required for the native D2C/data-rights flows. Booking and operations templates
# are used only when commercial automated updates are enabled.
# Docs checked: https://developers.facebook.com/docs/whatsapp/cloud-api/reference/messages
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-cloud-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-business-phone-number-id
WHATSAPP_EARLY_ACCESS_TEMPLATE=bubblewash_early_access_confirmation
WHATSAPP_PRIVACY_TEMPLATE=bubblewash_privacy_request_confirmation
WHATSAPP_BOOKING_TEMPLATE=bubblewash_booking_update
WHATSAPP_OPERATIONS_TEMPLATE=bubblewash_operations_alert
BUBBLEWASH_OPERATIONS_WHATSAPP=233XXXXXXXXX
