# PREPARATION ONLY: not a deployed or approved environment; no credentials included.
# Use a separate process, network boundary, empty synthetic-only database and secrets.
BUBBLEWASH_UAT_ENABLED=true
# Leave false until the coordinator verifies the isolation checklist in docs/UAT_ENVIRONMENT.md.
BUBBLEWASH_UAT_ISOLATION_CONFIRMED=false
BUBBLEWASH_PUBLIC_URL=https://uat.example.invalid
BUBBLEWASH_UAT_DATA_ROOT=/var/lib/bubblewash-uat
BUBBLEWASH_DATABASE_PATH=/var/lib/bubblewash-uat/uat.sqlite
BUBBLEWASH_DATABASE_DRIVER=sqlite
BUBBLEWASH_SESSION_SECRET=
BUBBLEWASH_DISABLE_DEMO_LOGIN=true
BUBBLEWASH_STAFF_AUTH_DISABLED=false
# Preserve the production booking pause. Enable only this isolated instance after admission.
BUBBLEWASH_BOOKINGS_DISABLED=true
NEXT_PUBLIC_BUBBLEWASH_ONLINE_PAYMENTS_ENABLED=false
NEXT_PUBLIC_BUBBLEWASH_AUTOMATED_UPDATES_ENABLED=false
BUBBLEWASH_RESEARCH_EMAIL_ENABLED=false
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
BUBBLEWASH_RESEARCH_RESEND_KEY=
BUBBLEWASH_OWNER_RESEND_KEY=
NEXT_PUBLIC_BUBBLEWASH_WHATSAPP=
NEXT_PUBLIC_BUBBLEWASH_CONTACT_EMAIL=
# No production owner/legacy staff credentials, session/MFA keys or maintenance token.
# Configure exactly one trusted-IP mode only after verifying the chosen UAT reverse proxy.
BUBBLEWASH_TRUST_EDGE_HEADERS=false
BUBBLEWASH_TRUST_PROXY_HEADERS=false
